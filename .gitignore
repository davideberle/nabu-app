# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.openclaw
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/MEMORY.md
/SOUL.md
/TOOLS.md
/USER.md
/memory
/secrets
*.wrong-original

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated recipe bundle (built by scripts/bundle-recipes.mjs)
src/data/recipes-bundle.json

# generated family dates — committed as a deploy mirror for Vercel builds
# (canonical source: projects/family/DATES.md)
# src/data/family-dates.generated.json   ← intentionally tracked

# database
*.db
*.db-wal
*.db-shm
.env.vercel
/tmp-vercel-env
